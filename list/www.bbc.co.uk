! ================================ !
! Start of Filters                 !
! ================================ !


! Only show "Continue watching..." in the main feed.
www.bbc.co.uk##:matches-path(/^\/iplayer\/?$/) .gel-wrap > :not([aria-label="Continue watching..."]):not(:has(section[aria-label="Continue watching..."]))

! Footer.
www.bbc.co.uk###orb-footer


! ================================ !
! End of Filters                   !
! ================================ !
